# Copia este archivo como ".env" (misma carpeta que pom.xml) y completa los valores.
# ".env" esta en .gitignore: NUNCA se sube al repositorio ni se comparte.

# Correos transaccionales (recuperacion de contrasena, etc.) via la API de
# Cloudflare Email. El "account-id" se ve en la URL del dashboard de Cloudflare;
# el token se crea en Mi perfil > API Tokens > Create Token, con permiso de
# envio de Email. Sin estos dos valores la app arranca pero no envia correos.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_TOKEN=

# Solo produccion (el perfil dev ya trae valores locales). El perfil prod NO se activa
# desde aqui: el servicio de produccion define la variable de entorno SPRING_PROFILES_ACTIVE=prod.
# DB_URL=jdbc:postgresql://localhost:5433/needlos
# DB_USER=
# DB_PASSWORD=
# JWT_SECRET=
# FRONTEND_URLS=https://needlos.com
# APP_URL=https://needlos.com
